[Unit]
Description=FactLens private daily database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/factlens
ExecStart=/usr/bin/python3 /home/ubuntu/factlens/devtools/operations.py backup
UMask=0077
TimeoutStartSec=35min
NoNewPrivileges=true
