# Local development only. Do not expose this unauthenticated PoC publicly.
DATABASE_URL=postgresql://factlens:development@127.0.0.1:55432/factlens
REDIS_URL=redis://127.0.0.1:56379
PORT=3000
API_HOST=127.0.0.1
# Optional absolute path shared by API and local worker:
# MEDIA_ROOT=/workspace/Fact-checking-website/.data/media
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# Selected providers: whisper-1 / gpt-4.1-mini / Brave Search.
# Keep disabled until keys and allowed destinations are configured.
FACTLENS_AI_MODE=disabled
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
# Approved USD micro limits; lowering is allowed. Raising is rejected.
FACTLENS_JOB_BUDGET_MICROS=200000
FACTLENS_MONTH_BUDGET_MICROS=20000000
# Set PROXY_CA_FILE for Docker builds/runs in a managed environment.
